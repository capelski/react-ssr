{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "rootDir": "./source",
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "es2016"
  },
  "include": ["source"]
}
